---
import { getEntry } from "astro:content";
import Layout from "../layouts/layout.astro";
import { getPosts } from "../lib/posts";

const home = await getEntry("pages", "index");
const posts = await getPosts({
  includeUnlisted: false,
  includeDrafts: import.meta.env.DEV,
});

const postsByMonth = Object.groupBy(
  // Group drafts together at the top, regardless of date.
  posts.toSorted((a, b) => Number(b.data.draft) - Number(a.data.draft)),
  (post) => {
    if (post.data.draft) return "Drafts";
    const date = post.data.date;
    if (!date) throw new Error("Post has no date");
    return date.toLocaleString("en-US", {
      timeZone: "UTC",
      month: "long",
      year: "numeric",
    });
  }
);
---

<Layout title="Ben Borgers’ Blog" ogImage={home?.data.cover_image}>
  <div class="post-list">
    {
      Object.entries(postsByMonth).map(([heading, posts]) => (
        <>
          {/* The first heading sits 31px higher, so the first post's title lines up
              with the title on its own page. */}
          <p class="mt-6 first-of-type:-mt-[31px] text-gray-400 font-[520]">
            {heading}
          </p>

          {/* A whole-pixel line height, so each row's square lands on whole
              pixels and doesn't shift against the one on the post's page. */}
          {posts!.map((post) => (
            <p class="mt-2 brand-shape-row leading-[20px]">
              <span aria-hidden="true" class="brand-shape" />

              <a href={`/${post.id}`} class="text-gray-900 text-xl">
                {post.data.title}
              </a>
            </p>
          ))}
        </>
      ))
    }
  </div>
</Layout>

<style>
  /* In these 20px rows the text sits 1px lower against the line's center
     than in a post's 24px title line, so the square drops 1px to match:
     it lands on the same pixel as the one on the post's page. */
  .brand-shape {
    margin-top: calc((1lh - 12px) / 2);
  }
</style>
