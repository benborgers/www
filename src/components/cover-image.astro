---
import { Image, type ImageMetadata } from "astro:assets";

interface Props {
  src: ImageMetadata;
  class?: string;
}

const { src, class: className } = Astro.props;
const width = Math.min(src.width, 1080);
---

<Image
  src={src}
  alt=""
  layout="constrained"
  width={width}
  quality={90}
  class:list={[
    "mx-auto h-auto max-h-48 max-w-full object-contain sm:max-h-54",
    className,
  ]}
  data-cover-image
/>
