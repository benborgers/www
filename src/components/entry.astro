---
import { render, type CollectionEntry } from "astro:content";
import CoverImage from "./cover-image.astro";
import Prose from "./prose.astro";
import { isFutureDate } from "../lib/posts";

interface Props {
  entry: CollectionEntry<"posts"> | CollectionEntry<"pages">;
  // "hidden" keeps the cover image out of the page, such as on the home page,
  // where it's still the social preview image.
  coverImagePosition?: "top" | "bottom" | "hidden";
}

const { entry, coverImagePosition = "top" } = Astro.props;

const title = entry.collection === "posts" ? entry.data.title : undefined;
const date = entry.collection === "posts" ? entry.data.date : undefined;
const coverImage = entry.data.cover_image;

const coverImageTop = coverImage && coverImagePosition === "top";
const coverImageBottom = coverImage && coverImagePosition === "bottom";

const draft =
  entry.collection === "posts" &&
  (entry.data.draft || isFutureDate(entry.data.date));

const hasFrontmatter = coverImageTop || title || date;

const { Content } = await render(entry);
---

{
  hasFrontmatter && (
    <>
      {title && (
        <h1 class="brand-shape-row text-gray-950 font-[620]">
          <span aria-hidden="true" class="brand-shape" />
          <span>{title}</span>
        </h1>
      )}

      {/* Where the date goes, above it when there is one. */}
      {draft && <p class="font-medium text-brand-red">[draft]</p>}

      {date && (
        <time class="block font-medium text-gray-400">
          {date.toLocaleString("en-US", {
            timeZone: "UTC",
            month: "long",
            day: "numeric",
            year: "numeric",
          })}
        </time>
      )}

      {coverImageTop && (
        <div class:list={["bg-gray-50 p-4", title && "mt-8"]}>
          <CoverImage src={coverImage} class="mix-blend-multiply" />
        </div>
      )}
    </>
  )
}

<div class:list={[hasFrontmatter && (coverImageTop ? "mt-8" : "mt-6")]}>
  <Prose>
    <Content />
  </Prose>

  {
    coverImageBottom && (
      <div class="mt-8 bg-gray-50 p-4">
        <CoverImage src={coverImage} class="mix-blend-multiply" />
      </div>
    )
  }
</div>

{import.meta.env.CHEETAH && (
  <script>
    window.addEventListener("message", (event) => {
      if (event.data.type === "scroll") {
        const scrollHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        window.scrollTo({
          top: scrollHeight * event.data.percentage,
          behavior: event.data.behavior,
        });
      }
    });
  </script>
)}
