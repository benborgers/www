---
import "allo-font/friendly";
import "../css/index.css";

import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  ogImage?: ImageMetadata;
  // Custom posts: keep the nav, but everything below it is the page's own. No
  // ClientRouter, so the page's scripts run fresh on every visit.
  custom?: boolean;
  // Custom posts only: caps the page and its nav at this width, centered, such
  // as "1100px". Without it they go edge to edge.
  maxWidth?: string;
}

const { title, ogImage, custom = false, maxWidth } = Astro.props;

// Every page except custom posts uses the redesign: 16px text in a
// single 480px column.
const redesign = !custom;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect x='0.75' y='0.75' width='14.5' height='14.5' rx='1.6' fill='%23ffbf00'/%3E%3C/svg%3E"
    />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Ben Borgers" />

    {
      ogImage && (
        <>
          <meta
            property="og:image"
            content={`${Astro.site!.origin}/og?path=${encodeURIComponent(ogImage.src)}`}
          />
          <meta name="twitter:card" content="summary_large_image" />
          <meta
            name="twitter:image"
            content={`${Astro.site!.origin}/og?path=${encodeURIComponent(ogImage.src)}`}
          />
          <meta name="twitter:site" content="@benborgers" />
          <meta name="twitter:creator" content="@benborgers" />
        </>
      )
    }

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Borgers"
      href="/rss"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script>
      import "../scripts/newsletter";
    </script>

    <script
      src="https://owl.benborgers.com/script.js"
      data-site="ZWCPJCUA"
      data-included-domains="benborgers.com,ben.page"
      data-spa="auto"
      defer></script>

    <script>
      // Load the Amp feedback widget only for people who have opened the site
      // with ?amp (the widget then remembers it in localStorage), so other
      // visitors don't download it.
      try {
        if (
          new URLSearchParams(location.search).has("amp") ||
          localStorage.getItem("amp-jellyware-visibility")
        ) {
          const script = document.createElement("script");
          script.src =
            "https://ampcode.com/w/client_01M6WNNA4115EAS690CJYQP09B.js";
          script.async = true;
          document.head.append(script);
        }
      } catch {}
    </script>

    {!custom && <ClientRouter />}
  </head>
  <body
    class:list={[
      "antialiased bg-white text-pretty selection:bg-brand-yellow-light",
      redesign && "redesign",
    ]}
  >
    <div
      class:list={[
        // Custom posts clip sideways overflow at the window edge, not the page's, so
        // shadows near the edge of a capped page show in full.
        custom && "grid min-h-svh grid-rows-[auto_1fr] overflow-x-clip",
      ]}
      style={maxWidth ? `--page-max-width: ${maxWidth}; --column-width: ${maxWidth}` : undefined}
    >
      {
        !import.meta.env.CHEETAH && (
          <nav class:list={["site-nav page-gutter pb-3", custom ? "pt-5" : "pt-8"]}>
            <div
              class:list={[
                "@container relative",
                // Other pages match the 480px column; custom posts match their maxWidth.
                !custom && "max-w-[480px] mx-auto",
                maxWidth && "max-w-(--page-max-width) mx-auto",
              ]}
            >
              <div class="brand-shape-row">
                <span aria-hidden="true" class="brand-shape brand-shape-triangle" />
                <a href="/" class="block max-w-max font-medium text-gray-950">
                  Ben Borgers
                </a>
              </div>
              <div class="mt-1 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 font-medium">
                <div class="brand-shape-row text-gray-950">
                  <span aria-hidden="true" class="brand-shape brand-shape-circle" />
                  <a
                    href="/blog"
                    aria-current={Astro.url.pathname.startsWith("/blog") ? "page" : undefined}
                  >
                    Blog
                  </a>
                  <a
                    href="/now"
                    aria-current={Astro.url.pathname === "/now" ? "page" : undefined}
                  >
                    Now
                  </a>
                  <a href="https://photos.ben.page" target="_blank">Photos</a>
                </div>

                <div class="flex gap-x-3 text-gray-400">
                  <a href="https://twitter.com/benborgers" target="_blank" aria-label="Twitter">
                    {/* Begrudgingly "X" once "Twitter" would wrap the nav. */}
                    <span class="@max-[274px]:hidden">Twitter</span>
                    <span class="hidden @max-[274px]:inline">X</span>
                  </a>
                  <a href="/rss" target="_blank">RSS</a>
                  {/* Newsletter hidden for now, along with its dialog below.
                  <button
                    type="button"
                    data-signup-trigger
                    class="cursor-pointer border-0 bg-transparent p-0 font-[inherit] text-inherit"
                    aria-haspopup="dialog"
                    aria-controls="newsletter-dialog"
                  >
                    Newsletter
                  </button>
                  */}
                </div>
              </div>
            </div>
          </nav>
        )
      }

      {/* Newsletter signup, hidden for now (see the nav).
      <dialog
        id="newsletter-dialog"
        class:list={[
          "newsletter-dialog fixed inset-x-4 top-4 bottom-auto m-0 w-auto max-w-none overflow-hidden rounded-[4px] border-0 bg-white p-0 text-base text-gray-950 shadow-[0_1px_2px_rgb(28_25_23/0.08),0_8px_24px_rgb(28_25_23/0.12)] backdrop:bg-gray-900/10 focus:outline-none lg:w-max",
          // The trigger is at the right end of the top nav, so the dialog opens
          // below it, right-aligned.
          "lg:inset-[var(--newsletter-below)_var(--newsletter-right)_auto_auto] lg:max-h-[calc(100dvh-var(--newsletter-below)-24px)]",
        ]}
        aria-label="Newsletter signup"
        tabindex="-1"
      >
        <div class="grid grid-cols-1 items-center p-4">
          <div class="newsletter-form-state">
            <p class="text-balance font-[520] text-gray-950 lg:whitespace-nowrap">
              Get an email when I publish a blog post
            </p>

            <form
              action="https://buttondown.com/api/emails/embed-subscribe/benborgers"
              method="post"
              target="newsletter-response"
              class="newsletter-form mt-3"
            >
              <div class="flex gap-2">
                <input
                  type="email"
                  name="email"
                  id="newsletter-email"
                  autocomplete="email"
                  aria-label="Email address"
                  placeholder="Email address"
                  required
                  autofocus
                  class="min-w-0 flex-1 rounded-[4px] border-0 bg-gray-50 px-2.5 py-1.5 font-sans font-[420] text-gray-950 outline-1 -outline-offset-1 outline-gray-200 transition-[outline-color] duration-75 placeholder:text-gray-400 focus:outline-brand-yellow"
                />
                <button
                  type="submit"
                  class="cursor-pointer rounded-[4px] border-0 bg-brand-yellow px-2.5 py-1.5 font-medium text-gray-950 transition-[filter] duration-75 hover:brightness-95 focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-gray-950 disabled:cursor-wait disabled:opacity-65"
                >
                  Subscribe
                </button>
              </div>
            </form>
          </div>

          <div
            class="newsletter-confirmed hidden"
            aria-live="polite"
            hidden
          >
            <p class="font-[620] text-gray-950">
              Check your email to confirm your subscription!
            </p>
          </div>
        </div>

        <iframe
          name="newsletter-response"
          title="Newsletter subscription response"
          class="newsletter-response pointer-events-none absolute size-px border-0 opacity-0"
        ></iframe>
      </dialog>
      */}

      <main
        class:list={[
          custom
            ? [
                "min-w-0",
                maxWidth &&
                  "page-gutter w-full max-w-[calc(var(--page-max-width)+var(--gutter-left)+1rem)] mx-auto",
              ]
            : "page-gutter max-w-[480px] mx-auto pt-16 pb-48 box-content",
        ]}
      >
        <slot />
      </main>

    </div>
  </body>
</html>

