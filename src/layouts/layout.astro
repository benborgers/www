---
import "../css/index.css";

import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  ogImage?: string;
}

const { title, ogImage } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <link rel="icon" href="https://emojicdn.elk.sh/🐙" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Ben Borgers" />

    {
      ogImage && (
        <>
          <meta
            property="og:image"
            content={`${Astro.site!.origin}/og?path=${ogImage}`}
          />
          <meta name="twitter:card" content="summary_large_image" />
          <meta
            name="twitter:image"
            content={`${Astro.site!.origin}/og?path=${ogImage}`}
          />
          <meta name="twitter:site" content="@benborgers" />
          <meta name="twitter:creator" content="@benborgers" />
        </>
      )
    }

    <link rel="stylesheet" href="https://md-ui.ben.page" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Borgers"
      href="/rss"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script
      src="https://owl.benborgers.com/script.js"
      data-site="ZWCPJCUA"
      data-included-domains="benborgers.com,ben.page"
      defer></script>

    <ClientRouter />
  </head>
  <body
    class="antialiased bg-white text-pretty selection:bg-brand-yellow-light"
  >
    <div class="lg:grid lg:grid-cols-[1fr_540px_1fr] lg:gap-x-8">
      {
        !import.meta.env.CHEETAH && (
          <nav class="p-4 pb-3 h-max lg:sticky lg:top-0 max-lg:bg-gray-50 max-lg:border-b max-lg:border-gray-100">
            <div class="max-lg:max-w-[540px] max-lg:mx-auto">
              <a
                href="/"
                class="block max-w-max text-gray-900 font-semibold bg-brand-blue-light px-1.5 -ml-1.5"
              >
                Ben Borgers
              </a>
              <div
                class="mt-2 flex items-center gap-x-[0.9375rem] overflow-x-auto whitespace-nowrap pb-1 lg:mt-3 lg:block lg:overflow-visible lg:pb-0"
              >
                <div class="flex items-center gap-x-3 text-gray-900 font-medium lg:block">
                  <a
                    href="/"
                    aria-current={Astro.url.pathname === "/" ? "page" : undefined}
                    class:list={[
                      "block max-w-max",
                      Astro.url.pathname === "/" &&
                        "underline decoration-[1.5px] underline-offset-[1.5px]",
                    ]}
                  >
                    Home
                  </a>
                  <a
                    href="/blog"
                    aria-current={Astro.url.pathname.startsWith("/blog") ? "page" : undefined}
                    class:list={[
                      "block max-w-max",
                      Astro.url.pathname.startsWith("/blog") &&
                        "underline decoration-[1.5px] underline-offset-[1.5px]",
                    ]}
                  >
                    Blog
                  </a>
                  <a
                    href="/now"
                    aria-current={Astro.url.pathname === "/now" ? "page" : undefined}
                    class:list={[
                      "block max-w-max",
                      Astro.url.pathname === "/now" &&
                        "underline decoration-[1.5px] underline-offset-[1.5px]",
                    ]}
                  >
                    Now
                  </a>
                </div>

                <div
                  class="flex items-center gap-x-3 text-gray-400 font-medium lg:mt-3 lg:block"
                >
                  <a
                    href="https://twitter.com/benborgers"
                    target="_blank"
                    class="block max-w-max"
                  >
                    Twitter
                  </a>
                  <a
                    href="/rss"
                    target="_blank"
                    class="block max-w-max"
                  >
                    RSS
                  </a>
                  <a
                    href="https://photos.ben.page"
                    target="_blank"
                    class="block max-w-max"
                  >
                    Photos
                  </a>
                </div>
              </div>
            </div>
          </nav>
        )
      }

      <main
        class="pt-14 lg:pt-24 pb-48 max-lg:px-4 max-lg:max-w-[540px] max-lg:mx-auto"
      >
        <slot />
      </main>

      <div>
        <slot name="sidebar" />
      </div>
    </div>
  </body>
</html>
