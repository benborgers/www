---
import "../css/index.css";

import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  ogImage?: ImageMetadata;
  coverImagePosition?: "top" | "bottom";
}

const { title, ogImage, coverImagePosition = "top" } = Astro.props;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <link rel="icon" href="https://emojicdn.elk.sh/🐙" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Ben Borgers" />

    {
      ogImage && (
        <>
          <meta
            property="og:image"
            content={`${Astro.site!.origin}/og?path=${encodeURIComponent(ogImage.src)}`}
          />
          <meta name="twitter:card" content="summary_large_image" />
          <meta
            name="twitter:image"
            content={`${Astro.site!.origin}/og?path=${encodeURIComponent(ogImage.src)}`}
          />
          <meta name="twitter:site" content="@benborgers" />
          <meta name="twitter:creator" content="@benborgers" />
        </>
      )
    }

    <link rel="stylesheet" href="https://md-ui.ben.page" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ben Borgers"
      href="/rss"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script>
      import "../scripts/newsletter";
    </script>

    <script
      src="https://owl.benborgers.com/script.js"
      data-site="ZWCPJCUA"
      data-included-domains="benborgers.com,ben.page"
      defer></script>

    <ClientRouter />
  </head>
  <body
    class="antialiased bg-white text-pretty selection:bg-brand-yellow-light"
  >
    <div class="lg:grid lg:grid-cols-[1fr_540px_1fr] lg:gap-x-8">
      {
        !import.meta.env.CHEETAH && (
          <nav class="p-4 pb-3 h-max lg:sticky lg:top-0 max-lg:bg-gray-50 max-lg:border-b max-lg:border-gray-100">
            <div class="max-lg:max-w-[540px] max-lg:mx-auto">
              <a
                href="/"
                class="block max-w-max text-gray-900 font-semibold bg-brand-blue-light px-1.5 -ml-1.5"
              >
                Ben Borgers
              </a>
              <div
                class="mt-2 lg:mt-3"
              >
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-gray-900 font-medium lg:block">
                  <a
                    href="/"
                    aria-current={Astro.url.pathname === "/" ? "page" : undefined}
                    class:list={[
                      "block max-w-max",
                      Astro.url.pathname === "/" &&
                        "underline decoration-[1.5px] underline-offset-[1.5px]",
                    ]}
                  >
                    Home
                  </a>
                  <a
                    href="/blog"
                    aria-current={Astro.url.pathname.startsWith("/blog") ? "page" : undefined}
                    class:list={[
                      "block max-w-max",
                      Astro.url.pathname.startsWith("/blog") &&
                        "underline decoration-[1.5px] underline-offset-[1.5px]",
                    ]}
                  >
                    Blog
                  </a>
                  <a
                    href="/now"
                    aria-current={Astro.url.pathname === "/now" ? "page" : undefined}
                    class:list={[
                      "block max-w-max",
                      Astro.url.pathname === "/now" &&
                        "underline decoration-[1.5px] underline-offset-[1.5px]",
                    ]}
                  >
                    Now
                  </a>
                </div>

                <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-gray-400 font-medium lg:mt-3 lg:block">
                  <div class="flex items-center gap-x-3 lg:block">
                    <a
                      href="https://twitter.com/benborgers"
                      target="_blank"
                      class="block max-w-max"
                    >
                      Twitter
                    </a>
                    <a
                      href="https://photos.ben.page"
                      target="_blank"
                      class="block max-w-max"
                    >
                      Photos
                    </a>
                  </div>

                  <div class="flex items-center gap-x-3 lg:mt-3 lg:block">
                    <a
                      href="/rss"
                      target="_blank"
                      class="block max-w-max"
                    >
                      RSS
                    </a>
                    <button
                      type="button"
                      class="newsletter-trigger block max-w-max cursor-pointer border-0 bg-transparent p-0 font-[inherit] text-inherit"
                      aria-haspopup="dialog"
                      aria-controls="newsletter-dialog"
                    >
                      Newsletter
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </nav>
        )
      }

      <dialog
        id="newsletter-dialog"
        class="newsletter-dialog fixed inset-x-4 top-4 bottom-auto m-0 w-auto max-w-none overflow-hidden rounded-none border-0 bg-gray-50 p-0 text-gray-900 shadow-lg backdrop:bg-gray-900/10 focus:outline-none lg:inset-[var(--newsletter-top)_auto_auto_var(--newsletter-left)] lg:w-max lg:max-w-[calc(100vw-var(--newsletter-left)-24px)] lg:max-h-[calc(100dvh-var(--newsletter-top)-24px)]"
        aria-label="Newsletter signup"
        tabindex="-1"
      >
        <div class="grid items-center p-4">
          <div class="newsletter-form-state">
            <p class="mr-4 text-balance leading-tight font-medium text-gray-900 lg:whitespace-nowrap">
              Get an email when I publish a blog post
            </p>

            <form
              action="https://buttondown.com/api/emails/embed-subscribe/benborgers"
              method="post"
              target="newsletter-response"
              class="newsletter-form mt-3"
            >
              <div class="flex gap-2">
                <input
                  type="email"
                  name="email"
                  id="newsletter-email"
                  autocomplete="email"
                  aria-label="Email address"
                  placeholder="Email address"
                  required
                  autofocus
                  class="min-w-0 flex-1 border-2 border-gray-300 bg-white py-2 indent-3 font-sans text-gray-900 placeholder:text-gray-400 focus:border-brand-blue focus:outline-none"
                />
                <button
                  type="submit"
                  class="cursor-pointer border border-gray-900 bg-gray-900 px-3 py-2 text-sm font-semibold text-white focus:border-brand-blue focus:outline-none disabled:cursor-wait disabled:opacity-65"
                >
                  Subscribe
                </button>
              </div>
            </form>
          </div>

          <div
            class="newsletter-confirmed hidden text-center"
            aria-live="polite"
            hidden
          >
            <p class="leading-tight font-medium text-gray-900">
              Check your email to confirm your subscription!
            </p>
          </div>
        </div>

        <iframe
          name="newsletter-response"
          title="Newsletter subscription response"
          class="newsletter-response pointer-events-none absolute size-px border-0 opacity-0"
        ></iframe>
      </dialog>

      <main
        class:list={[
          "lg:pt-24 pb-48 max-lg:px-4 max-lg:max-w-[540px] max-lg:mx-auto",
          coverImagePosition === "bottom" ? "pt-8" : "pt-14",
        ]}
      >
        <slot />
      </main>

      <div>
        <slot name="sidebar" />
      </div>
    </div>
  </body>
</html>
